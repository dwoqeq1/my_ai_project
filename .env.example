# ===== 复制本文件为 .env，再填入真实值 =====
# .env 已被 .gitignore 排除，不要把它提交到任何代码仓库或发给别人。

# --- 必填：阿里云百炼 DashScope API Key ---
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- 可选：模型与接口地址（默认值一般不用改）---
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus
EMBEDDING_MODEL=text-embedding-v3

# --- 可选：向量库与知识库文件位置 ---
CHROMA_PATH=./chroma_db
COLLECTION_NAME=knowledge
KNOWLEDGE_FILE=./knowledge/example.txt

# --- 可选：RAG 检索参数 ---
# 向量距离阈值，只作用于向量召回这一路（BM25 命中不受它管）。默认 1.0
RAG_DISTANCE_THRESHOLD=1.0
# 最终返回给模型的片段数
DEFAULT_TOP_K=3

# --- 可选：混合检索（BM25 + 向量）---
# 粗召回数量，故意放宽，把候选捞全后交给精排收紧。库不足该数时自动截断
RECALL_TOP_K=20
# 关掉 BM25 则退化为纯向量检索（设为 0）
ENABLE_BM25=1
# RRF 融合常数与两路权重。融合只看排名不看原始分，故量纲不同也能相加
RRF_K=60
RRF_VECTOR_WEIGHT=1.0
RRF_BM25_WEIGHT=1.0

# --- 可选：精排（CrossEncoder Rerank）---
ENABLE_RERANK=1
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_MAX_LENGTH=512
# ★ 精排分数阈值。默认 0.005 由 16 条标注查询实测得出（详见 config.py 注释）。
#   务必偏低：漏召的代价远大于误召。改阈值前请先重新实测。
RERANK_SCORE_THRESHOLD=0.005
# ★★ 必须为 0。bge-reranker-base 是单输出模型，apply_softmax=1 时
#   所有分数恒为 1.0，排序退化为随机，精排会静默失效。
RERANK_APPLY_SOFTMAX=0
# 模型已在本地缓存时设 1，跳过联网校验，加载更快更稳；需下载时设 0
RERANK_OFFLINE=1

# --- 可选：day5_multi_tools.py 的真实发信工具 ---
# 邮箱登录密码请一律放这里，不要写进代码
SENDER_EMAIL=your_qq_number@qq.com
SENDER_AUTH_CODE=your_smtp_auth_code
SMTP_HOST=smtp.qq.com
SMTP_PORT=465

# --- 可选：调试 ---
# 设为 1 时把发给大模型的完整 messages 打到控制台（含用户输入，生产环境建议 0）
VERBOSE_LOG=0
